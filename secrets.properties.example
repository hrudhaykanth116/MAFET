# Copy this file to secrets.properties and fill in your actual API keys.
# secrets.properties is gitignored and must NEVER be committed.

# Pexels API — https://www.pexels.com/api/
PEXELS_API_KEY="your_pexels_api_key_here"

# TMDB API — https://www.themoviedb.org/settings/api
TMDB_API_KEY="your_tmdb_api_key_here"

# OpenWeatherMap API — https://home.openweathermap.org/api_keys
# Both geo coding and forecast can use the same key
OPEN_WEATHER_FORECAST_API_KEY="your_openweather_api_key_here"
