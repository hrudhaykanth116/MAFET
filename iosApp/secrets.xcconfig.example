// Copy this file to secrets.xcconfig and fill in your actual API keys.
// secrets.xcconfig is gitignored and must NEVER be committed.
//
// After copying, wire this file into Xcode:
//   1. Open iosApp.xcodeproj in Xcode
//   2. Click the project root → select the iosApp project → Info tab
//   3. Under Configurations, expand Debug and Release
//   4. For the iosApp target row, set the configuration file to secrets.xcconfig
//   5. Do this for both Debug and Release

TMDB_API_KEY = your_tmdb_api_key_here
OPEN_WEATHER_FORECAST_API_KEY = your_openweather_api_key_here
OPEN_WEATHER_GEO_CODING_API_KEY = your_openweather_api_key_here
PEXELS_API_KEY = your_pexels_api_key_here
